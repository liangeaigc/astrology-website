{
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "static"
    }
  ],
  "routes": [
    {
      "src": "/api/calculate",
      "dest": "/api/calculate.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
